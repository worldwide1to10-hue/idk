      "acceptance": [{"kind":"assert","spec":"{\"path\":\"out/csv_tools.py\",\"contains\":\"def parse_rows\"}"},{"kind":"assert","spec":"{\"path\":\"out/test_csv_tools.py\",\"contains\":\"def test_parse_rows\"}"}]
