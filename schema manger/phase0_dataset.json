      "task_id": "research-01-provider-boundary",
      "shape": "breadth_research",
      "fixture": "phase0_fixtures",
      "prompt": "Read architecture.md. Explain the provider-agnostic boundary and name the adapter and library involved. Be precise and use only the evidence pack.",
