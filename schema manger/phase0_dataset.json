      "acceptance": [{"kind":"assert","spec":"{\"path\":\"out/name_utils.py\",\"contains\":\"def normalize_name\"}"},{"kind":"assert","spec":"{\"path\":\"out/test_name_utils.py\",\"contains\":\"def test_normalize_name\"}"}]
    },
